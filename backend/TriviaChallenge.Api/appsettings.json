{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Azure.Cosmos": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CosmosDb": {
    "EndpointUri": "",
    "PrimaryKey": "",
    "DatabaseName": "TriviaChallengeDb",
    "UsersContainerName": "Users",
    "QuestionsContainerName": "Questions",
    "QuestionPoolsContainerName": "QuestionPools",
    "QuestionDrawsContainerName": "QuestionDraws",
    "GameSessionsContainerName": "GameSessions",
    "GameSessionAnswersContainerName": "GameSessionAnswers",
    "MaxRetryAttempts": 3,
    "MaxRetryWaitTimeSeconds": 10
  },
  "Telemetry": {
    "Enabled": false,
    "ConnectionString": "",
    "FullyQualifiedNamespace": "",
    "EventHubName": ""
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760
    }
  }
}

